....................    static unsigned char aux =70;  
042C:  MOVLW  46
042D:  MOVWF  3A
....................    static unsigned char t_bip;  
042E:  CLRF   3B
....................   
....................    if(!aux)  
*
0049:  MOVF   3A,F
004A:  BTFSS  03.2
004B:  GOTO   053
....................    {  
....................       if(apaga_d2)   apaga_d2 =0;  
004C:  BTFSS  38.2
004D:  GOTO   050
004E:  BCF    38.2
....................       else           apaga_d2 =1;  
004F:  GOTO   051
0050:  BSF    38.2
....................       aux = 70;  
0051:  MOVLW  46
0052:  MOVWF  3A
....................    }  
....................   
....................    output_d(portd &= 0b00001111);   //Apaga todos os dígitos.  
0053:  MOVLW  0F
0054:  ANDWF  08,F
....................   
....................    switch(digito)  
....................    {  
0055:  MOVF   39,W
0056:  ADDLW  F9
0057:  BTFSC  03.0
0058:  GOTO   08A
0059:  ADDLW  07
005A:  GOTO   09D
....................       case 0:  port_disp = d0;   //Põe o valor do primeiro dígito na saída.  
005B:  MOVF   29,W
005C:  MOVWF  06
....................                output_d(portd |= 0b10010000);   //Liga o display d0.  
005D:  MOVLW  90
005E:  IORWF  08,F
....................                break;  
005F:  GOTO   08A
....................   
....................       case 1:  port_disp = d1;  
0060:  MOVF   2A,W
0061:  MOVWF  06
....................                if(dp_graus)   port_disp |= 0b10000000;   //Liga o DP.  
0062:  BTFSC  38.1
0063:  BSF    06.7
....................                output_d(portd |= 0b10100000);   //Display d1.  
0064:  MOVLW  A0
0065:  IORWF  08,F
....................                break;  
0066:  GOTO   08A
....................   
....................       case 2:  port_disp = d2;  
0067:  MOVF   2B,W
